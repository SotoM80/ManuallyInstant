# Copy to .env and change what you need (specs/cmykserver.md). .env is not kept in git.
PORT=8787
CORS_ORIGINS=http://localhost:5173

# The ICC profile file, relative to server/ or absolute (see profiles/README.md)
CMYK_PROFILE_PATH=profiles/ISOcoated_v2_eci.icc
CMYK_PROFILE_ID=FOGRA39
CMYK_PROFILE_NAME=ISO Coated v2 (ECI)
CMYK_BLACK_POINT_COMPENSATION=true

MAX_PAGE_MB=40
MAX_PAGE_PIXELS=25000000
MAX_CONCURRENT=2
